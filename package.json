{
  "name": "wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Self-custodial Bitcoin-wallet (alleen BTC) als PWA en Capacitor-app.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "check": "npm audit --audit-level=high && npm run typecheck && npm test && vite build",
    "cap:sync": "vite build && cap sync"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/privacy-screen": "8.0.0",
    "@capacitor/core": "8.6.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@paulmillr/qr": "0.3.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
